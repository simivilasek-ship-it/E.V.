# JARVIS — příklad konfigurace prostředí
# Zkopíruj tento soubor jako .env a vyplň hodnoty.

# ── API bind & LAN auth (volitelné) ──────────────────
# Výchozí: localhost only (127.0.0.1). Pro přístup z jiných zařízení v síti:
# JARVIS_BIND_HOST=0.0.0.0
# Token pro ne-localhost požadavky:
# JARVIS_API_TOKEN=your_secret_token
# Vyžadovat token pro ne-localhost požadavky (1 = zapnuto, doporučeno s 0.0.0.0):
# JARVIS_API_AUTH_REQUIRED=1

# ── Brave Search ─────────────────────────────────────
# BRAVE_API_KEY=your_brave_api_key

# ── GitHub ───────────────────────────────────────────
# GITHUB_TOKEN=ghp_...

# ── Google Maps ──────────────────────────────────────
# GOOGLE_MAPS_API_KEY=your_google_maps_key

# ── Slack ────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_TEAM_ID=T...

# ── Discord ──────────────────────────────────────────
# DISCORD_TOKEN=your_bot_token

# ── Spotify ──────────────────────────────────────────
# SPOTIFY_CLIENT_ID=your_client_id
# SPOTIFY_CLIENT_SECRET=your_secret

# ── Notion ───────────────────────────────────────────
# NOTION_API_KEY=secret_...
