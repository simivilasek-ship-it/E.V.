# JARVIS v3.0 — Environment Configuration
# Kopíruj tento soubor na .env a vyplň své hodnoty
# NIKDY necommituj .env soubor do verzovacího systému!

# ═════════════════════════════════════════════════════════
# OLLAMA — LLM Configuration
# ═════════════════════════════════════════════════════════

# URL Ollama API serveru
OLLAMA_URL=http://localhost:11434/api/chat

# Model pro inference
# Doporučené: qwen2.5:3b (3B, rychlý), llama3.1:8b (8B, lepší)
OLLAMA_MODEL=qwen2.5:3b

# ═════════════════════════════════════════════════════════
# TEXT-TO-SPEECH (TTS)
# ═════════════════════════════════════════════════════════

# Povolení TTS (true/false)
TTS_ENABLED=true

# Voice pro edge-tts (Czech voices: cs-CZ-AntoninNeural, cs-CZ-ZuzanaNeural)
TTS_VOICE=cs-CZ-AntoninNeural

# Rychlost řeči (50-400, výchozí 170)
TTS_RATE=170

# ═════════════════════════════════════════════════════════
# SPEECH-TO-TEXT (STT)
# ═════════════════════════════════════════════════════════

# Jazyk rozpoznávání (cs-CZ, en-US, etc.)
STT_LANGUAGE=cs-CZ

# Energy threshold pro detekci řeči (100-4000, výchozí 300)
STT_ENERGY_THRESHOLD=300

# Timeout pro poslouchání (sekundy)
STT_TIMEOUT=10

# Maximální počet slov v jedné větě
STT_PHRASE_LIMIT=15

# ═════════════════════════════════════════════════════════
# GUI — User Interface
# ═════════════════════════════════════════════════════════

# Velikost okna (WIDTHxHEIGHT)
WINDOW_SIZE=560x760

# Počet zpráv v historii
HISTORY_SIZE=20

# ═════════════════════════════════════════════════════════
# LOGGING
# ═════════════════════════════════════════════════════════

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Jméno log souboru
LOG_FILE=jarvis.log

# JSON structured logging (true/false)
LOG_JSON_FORMAT=true

# ═════════════════════════════════════════════════════════
# PLUGIN SYSTEM
# ═════════════════════════════════════════════════════════

# Povolení pluginů (true/false)
PLUGINS_ENABLED=true

# Adresář s pluginy
PLUGINS_DIR=plugins

# ═════════════════════════════════════════════════════════
# ASYNC ENGINE
# ═════════════════════════════════════════════════════════

# Počet worker vláken
ASYNC_MAX_WORKERS=4

# Maximální velikost queue
ASYNC_MAX_QUEUE=100

# ═════════════════════════════════════════════════════════
# ERROR HANDLING
# ═════════════════════════════════════════════════════════

# Maximální počet chyb v logu
MAX_ERROR_LOG=1000

# Rate limit window (sekundy)
RATE_LIMIT_WINDOW=60.0

# Maximální počet requestů v rate limit window
RATE_LIMIT_MAX=10

# ═════════════════════════════════════════════════════════
# SECURITY
# ═════════════════════════════════════════════════════════

# Audit log soubor
AUDIT_LOG_FILE=audit.log

# Povolení audit logu (true/false)
AUDIT_ENABLED=true

# ═════════════════════════════════════════════════════════
# MEMORY SYSTEM
# ═════════════════════════════════════════════════════════

# Adresář pro neural memory data
MEMORY_DIR=memory_data

# ═════════════════════════════════════════════════════════
# DEVELOPEMENT (pouze pro development)
# ═════════════════════════════════════════════════════════

# Debug mode — detailnější logování
DEBUG_MODE=false

# Reload on file change (pro development)
AUTO_RELOAD=false
