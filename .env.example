# JARVIS v3.0 — Environment Configuration
# Kopíruj tento soubor na .env a vyplň své hodnoty
# NIKDY necommituj .env soubor do verzovacího systému!

# ═════════════════════════════════════════════════════════
# OLLAMA — LLM Configuration
# ═════════════════════════════════════════════════════════

# URL Ollama API serveru
OLLAMA_URL=http://localhost:11434/api/chat

# Model pro inference
# Doporučené: qwen2.5:3b (3B, rychlý), llama3.1:8b (8B, lepší)
OLLAMA_MODEL=qwen2.5:3b

# ═════════════════════════════════════════════════════════
# TEXT-TO-SPEECH (TTS)
# ═════════════════════════════════════════════════════════

# Povolení TTS (true/false)
TTS_ENABLED=true

# Voice pro edge-tts (Czech voices: cs-CZ-AntoninNeural, cs-CZ-ZuzanaNeural)
TTS_VOICE=cs-CZ-AntoninNeural

# Rychlost řeči (50-400, výchozí 170)
TTS_RATE=170

# ═════════════════════════════════════════════════════════
# SPEECH-TO-TEXT (STT)
# ═════════════════════════════════════════════════════════

# Jazyk rozpoznávání (cs-CZ, en-US, etc.)
STT_LANGUAGE=cs-CZ

# Energy threshold pro detekci řeči (100-4000, výchozí 300)
STT_ENERGY_THRESHOLD=300

# Timeout pro poslouchání (sekundy)
STT_TIMEOUT=10

# Maximální počet slov v jedné větě
STT_PHRASE_LIMIT=15

# ═════════════════════════════════════════════════════════
# GUI — User Interface
# ═════════════════════════════════════════════════════════

# Velikost okna (WIDTHxHEIGHT)
WINDOW_SIZE=560x760

# Počet zpráv v historii
HISTORY_SIZE=20

# ═════════════════════════════════════════════════════════
# LOGGING
# ═════════════════════════════════════════════════════════

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Jméno log souboru
LOG_FILE=jarvis.log

# JSON structured logging (true/false)
LOG_JSON_FORMAT=true

# ═════════════════════════════════════════════════════════
# PLUGIN SYSTEM
# ═════════════════════════════════════════════════════════

# Povolení pluginů (true/false)
PLUGINS_ENABLED=true

# Adresář s pluginy
PLUGINS_DIR=plugins

# ═════════════════════════════════════════════════════════
# ASYNC ENGINE
# ═════════════════════════════════════════════════════════

# Počet worker vláken
ASYNC_MAX_WORKERS=4

# Maximální velikost queue
ASYNC_MAX_QUEUE=100

# ═════════════════════════════════════════════════════════
# ERROR HANDLING
# ═════════════════════════════════════════════════════════

# Maximální počet chyb v logu
MAX_ERROR_LOG=1000

# Rate limit window (sekundy)
RATE_LIMIT_WINDOW=60.0

# Maximální počet requestů v rate limit window
RATE_LIMIT_MAX=10

# ═════════════════════════════════════════════════════════
# SECURITY
# ═════════════════════════════════════════════════════════

# Audit log soubor
AUDIT_LOG_FILE=audit.log

# Povolení audit logu (true/false)
AUDIT_ENABLED=true

# ═════════════════════════════════════════════════════════
# WAKE WORD
# ═════════════════════════════════════════════════════════

# Klíčové slovo pro probuzení (výchozí: jarvis)
WAKE_WORD=jarvis

# Povolení wake word detekce (true/false)
WAKE_WORD_ENABLED=true

# ═════════════════════════════════════════════════════════
# MEMORY SYSTEM
# ═════════════════════════════════════════════════════════

# Adresář pro memory data (JSON fallback i neural-ai-memory)
MEMORY_DIR=memory_data

# ═════════════════════════════════════════════════════════
# MCP — Model Context Protocol
# ═════════════════════════════════════════════════════════

# ── Existující servery ─────────────────────────────
# Brave Search — https://api.search.brave.com/ (zdarma tier: 2000 req/měsíc)
BRAVE_API_KEY=

MCP_FILESYSTEM_ENABLED=true
MCP_BRAVE_ENABLED=true

# Adresáře povolené pro MCP filesystem (oddělené čárkou)
# MCP_FILESYSTEM_DIRS=/home/user,/home/user/Dokumenty

# ── Nové MCP servery v4.5 ──────────────────────────

# GitHub MCP — issues, PRs, code search, commit history
# Získej: GitHub → Settings → Developer settings → Personal access tokens
# Potřebná oprávnění: repo, read:org
GITHUB_TOKEN=

# Google Maps MCP — geocoding, navigace, POI, vzdálenosti
# Získej: console.cloud.google.com → Maps JavaScript API (zdarma $200/měsíc)
GOOGLE_MAPS_API_KEY=

# Slack MCP — čtení kanálů, posílání zpráv, vyhledávání
# Získej: api.slack.com → Create App → Bot Token Scopes
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# YouTube Transcript — bez API klíče, automaticky povoleno
# MCP_YOUTUBE_TRANSCRIPT_ENABLED=true

# SQLite MCP — přímé SQL dotazy do databáze (opt-in)
# MCP_SQLITE_ENABLED=false
# MCP_SQLITE_DB=memory_data/memories.db

# Everything Search — rychlé hledání souborů (opt-in, Windows/Linux)
# MCP_EVERYTHING_ENABLED=false

# ═════════════════════════════════════════════════════════
# SECRETS — přidej sem API klíče pokud rozšíříš JARVIS
# ═════════════════════════════════════════════════════════

# Příklady (připraveno pro rozšíření):
# OPENWEATHER_API_KEY=tvůj_klíč
# GOOGLE_API_KEY=tvůj_klíč
# SPOTIFY_CLIENT_ID=tvůj_id
# SPOTIFY_CLIENT_SECRET=tvůj_secret

# ═════════════════════════════════════════════════════════
# DEVELOPEMENT (pouze pro development)
# ═════════════════════════════════════════════════════════

# Debug mode — detailnější logování
DEBUG_MODE=false

# Reload on file change (pro development)
AUTO_RELOAD=false
