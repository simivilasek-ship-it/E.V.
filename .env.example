# JARVIS configuration — copy to .env and fill in values
# Generate a secure token: python scripts/generate_token.py

# Required for LAN access (generate with: python scripts/generate_token.py --write)
JARVIS_API_TOKEN=

# Set to 1 to require token auth (recommended for non-localhost)
JARVIS_API_AUTH_REQUIRED=0

# Bind address (use 0.0.0.0 for Docker/LAN)
JARVIS_BIND_HOST=127.0.0.1
JARVIS_PORT=8002

# Ollama settings
OLLAMA_HOST=http://localhost:11434
JARVIS_DEFAULT_MODEL=llama3.2

# ElevenLabs TTS — teplý ženský hlas Lily (eleven_v3). Klíč z https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku

# OpenAI — chat (GPT-4o-mini). Klíč z https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# CURSOR_API_KEY=   # cursor.com/dashboard/integrations — E.V. předá úkol Cursor agentovi
# CURSOR_WORKSPACE=/home/simi/E.V.
# WEATHER_CITY=Praha
JARVIS_DEBUG=0
JARVIS_LOG_LEVEL=INFO
