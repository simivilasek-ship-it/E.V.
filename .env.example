# JARVIS configuration — copy to .env and fill in values
# Generate a secure token: python scripts/generate_token.py

# Required for LAN access (generate with: python scripts/generate_token.py --write)
JARVIS_API_TOKEN=

# Set to 1 to require token auth (recommended for non-localhost)
JARVIS_API_AUTH_REQUIRED=0

# Bind address (use 0.0.0.0 for Docker/LAN)
JARVIS_BIND_HOST=127.0.0.1
JARVIS_PORT=8002

# Ollama settings
OLLAMA_HOST=http://localhost:11434
JARVIS_DEFAULT_MODEL=llama3.2

# Optional: API keys for MCP tools
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# BRAVE_API_KEY=
# GITHUB_TOKEN=

# Feature flags
JARVIS_DEBUG=0
JARVIS_LOG_LEVEL=INFO
