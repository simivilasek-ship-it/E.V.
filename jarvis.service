[Unit]
Description=JARVIS Voice Assistant
After=network.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=simi
WorkingDirectory=/home/simi/Stažené/nepojmenovaná složka
Environment=PATH=/home/simi/Stažené/nepojmenovaná složka/venv/bin
ExecStart=/home/simi/Stažené/nepojmenovaná složka/venv/bin/python jarvis.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target